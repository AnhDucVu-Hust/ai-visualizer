# =============================================================================
# AI Visualizer — Environment variables (tương đương config.yaml + secrets)
# =============================================================================
# Local:  cp .env.example .env   rồi điền giá trị thật (file .env đã .gitignore).
#
# Render: Không có file .env trên server — Render inject các biến vào process.
#         Vào Dashboard → Environment → dán từng biến, hoặc "Add from .env"
#         và dán nội dung file .env của bạn (cùng cú pháp).
#         https://render.com/docs/configure-environment-variables
#
# API keys: một biến, nhiều key cách nhau bằng dấu phẩy (xoay khi 429).
# =============================================================================

# --- Secrets (bắt buộc trên Render nếu không đặt key trong config.yaml) ---
# Tương đương llm.api_keys trong YAML: một biến, nhiều key = dấu phẩy (xoay 429).
# Alias tùy chọn khi LLM_CLIENT=openai|openrouter: LLM_API_KEYS=
OPENAI_API_KEY=
# LLM_API_KEYS=

# client=gemini
GEMINI_API_KEY=

# client=openrouter
OPENROUTER_API_KEY=

# --- transcription: (config.yaml → transcription) ---
TRANSCRIPTION_ENGINE=groq
STT_MODEL=whisper-large-v3-turbo
STT_DEVICE=auto
STT_COMPUTE_TYPE=default
STT_LOG_PROGRESS=true

# --- llm: (config.yaml → llm) ---
LLM_CLIENT=openai
# Endpoint OpenAI-compatible (Groq / OpenAI / …). Alias: OPENAI_BASE_URL
LLM_BASE_URL=https://api.groq.com/openai/v1
# One model or prioritized fallback list (switches on 429): model_a,model_b,model_c
LLM_MODEL=llama-3.3-70b-versatile
LLM_LANGUAGE=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=768
SKIP_CHARACTERS=false

# Style chung cho prompt ảnh (khớp llm.global_style trong YAML)
GLOBAL_STYLE=cinematic realistic

# --- logging ---
VERBOSE=false

# --- VPS: nginx gửi file MP4 trực tiếp (X-Accel-Redirect) ---
# Bật khi chạy sau nginx với deploy/nginx/ai-visualizer.conf.example
# Local dev: để trống hoặc =0
# NGINX_ACCEL_ENABLED=1
# NGINX_ACCEL_INTERNAL_PREFIX=/internal-temp/

# --- Backend: dọn file trong temp/ (backend/app.py) ---
# Số giây sau khi upload (audio/music) hoặc sau khi job kết thúc trước khi xóa path đã lên lịch.
# Mặc định trong code: 1200 (20 phút). VIDEO_JOB_TTL_SECONDS mặc định = UPLOAD nếu không set.
# Lưu ý: TTL video là thời gian sau khi job xong — user cần kịp tải MP4 trong khoảng đó.
# UPLOAD_JOB_TTL_SECONDS=300
# VIDEO_JOB_TTL_SECONDS=300

# --- FFmpeg / video_combine (backend → run_ffmpeg_video_pipeline) ---
# Preset không chọn trên frontend; dùng env hoặc video_combine_config.yaml.
# Env ghi đè YAML. Optional: VIDEO_FPS, VIDEO_THREADS, VIDEO_CRF, VIDEO_BURN_SUBTITLES, …
# Xem backend/video_combine_settings.py
VIDEO_PRESET=ultrafast
# VIDEO_FPS=24
# VIDEO_THREADS=16
# VIDEO_CRF=20
# VIDEO_BURN_SUBTITLES=true

# Alias cho TRANSCRIPTION_ENGINE (engine STT)
# STT_ENGINE=groq
